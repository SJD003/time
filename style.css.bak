:root{--primary:#d6c7a1;--bg:#0f0f0f;--card:#1e1e1e;--card2:#262626;--border:rgba(255,255,255,0.08);--danger:#ff6b6b;--success:#2ecc71;--text:#f5f5f5;--muted:#9aa0a6;--warning:#ff9800;--p:var(--primary);--sin:var(--danger);--ok:var(--success)}
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,Tahoma,sans-serif}
body{background:var(--bg);color:var(--text);direction:rtl;min-height:100vh}
.app{max-width:480px;margin:0 auto;min-height:100vh;background:linear-gradient(180deg,#1a1a1a 0%,#0f0f0f 100%);padding-bottom:90px}
.header{padding:16px;background:rgba(255,255,255,0.03);border-bottom:1px solid var(--border);position:sticky;top:0;backdrop-filter:blur(12px);z-index:20}
.header-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.dates{flex:1}.date-greg{font-size:14px;font-weight:700}.date-hijri{font-size:12px;color:var(--muted);margin-top:4px}
.btn-prayer{background:var(--card);border:1px solid var(--border);color:var(--text);padding:8px 14px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer}
.prayer-dropdown{display:none;margin-top:14px;background:var(--card);border-radius:16px;padding:14px;border:1px solid var(--border)}
.prayer-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.p-item{display:flex;flex-direction:column;gap:2px;background:rgba(255,255,255,0.04);padding:10px 12px;border-radius:12px}
.p-item span{font-size:12px;color:var(--muted)}.p-item b{font-size:14px;color:var(--primary);direction:ltr;text-align:right}
.loc-bar,.notify-bar{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-size:11px;color:var(--muted);flex-wrap:wrap;gap:8px;padding-top:12px;border-top:1px solid var(--border)}
.btn-loc{background:transparent;border:1px dashed var(--primary);color:var(--primary);padding:6px 12px;border-radius:8px;font-size:11px;cursor:pointer}
.btn-notify{background:var(--primary);color:#000;border:none;padding:7px 14px;border-radius:8px;font-weight:700;font-size:11px;cursor:pointer}
.counter-wrap{margin-top:14px;text-align:center}.counter{font-size:15px;font-weight:700;color:var(--primary)}
.progress-track{height:6px;background:rgba(255,255,255,0.08);border-radius:20px;margin-top:10px;overflow:hidden}
.progress-fill{height:100%;width:50%;background:var(--primary);border-radius:20px;transition:width 0.6s ease}
.offline-badge{display:none;background:var(--warning);color:#000;text-align:center;padding:7px 12px;font-size:12px;font-weight:700;position:sticky;top:0;z-index:30}
.tabs{position:sticky;top:115px;z-index:15;display:flex;gap:8px;padding:12px 16px;background:#0f0f0f;width:100%;max-width:480px;margin:0 auto}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 6px;border-radius:14px;border:1px solid var(--border);background:var(--card);color:var(--muted);font-weight:600;font-size:12px;cursor:pointer}
.tab.active{background:var(--primary);color:#000;border-color:var(--primary)}
.content{padding:8px 16px;display:flex;flex-direction:column;gap:10px;min-height:300px}
.item-card{display:flex;justify-content:space-between;align-items:center;background:var(--card);padding:14px 16px;border-radius:14px;border:1px solid var(--border)}
.item-card.done{opacity:0.55}.item-card.col{flex-direction:column;align-items:stretch;gap:12px}
.item-info b{font-size:14px}.item-info span{font-size:11px;color:var(--muted)}
.btns{display:flex;gap:8px}.btn{width:38px;height:38px;border-radius:10px;border:1px solid var(--border);background:rgba(255,255,255,0.04);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center}
.btn-check.active-s{background:var(--danger);color:#fff}.btn-check.active-o{background:var(--success);color:#fff}
.btn-save{background:var(--primary);color:#000;border:none;padding:10px 16px;border-radius:10px;font-weight:700;cursor:pointer}
.btn-cancel{background:rgba(255,255,255,.06);color:var(--muted);border:1px solid var(--border);padding:10px 16px;border-radius:10px;cursor:pointer}
.fab{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);width:56px;height:56px;border-radius:50%;background:var(--primary);color:#000;border:none;font-size:28px;box-shadow:0 8px 24px rgba(214,199,161,0.35);z-index:30}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(6px);align-items:center;justify-content:center;z-index:100;padding:20px}
.overlay.show{display:flex}.modal{background:var(--card2);width:100%;max-width:380px;border-radius:20px;padding:20px;border:1px solid var(--border)}
.modal input,.modal textarea{width:100%;background:rgba(255,255,255,0.06);border:1px solid var(--border);color:var(--text);padding:12px 14px;border-radius:12px;margin-bottom:12px;font-size:14px;outline:none}
.modal-actions{display:flex;gap:10px}.btn-primary{flex:1;background:var(--primary);color:#000;border:none;padding:11px 16px;border-radius:10px;font-weight:700;cursor:pointer}
.btn-danger{background:rgba(255,107,107,0.15);color:var(--danger);border:1px solid rgba(255,107,107,0.25);padding:11px 16px;border-radius:10px;cursor:pointer}
.btn-ghost{background:rgba(255,255,255,0.06);color:var(--muted);border:1px solid var(--border);padding:11px 16px;border-radius:10px;cursor:pointer}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.stack{display:flex;flex-direction:column;gap:8px}
.check-row{display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,0.05);padding:10px 14px;border-radius:10px;font-size:13px}
.dim{color:var(--muted);font-size:11px}.ver{text-align:center;color:#555;font-size:10px;margin-top:20px}
/* === القبلة - مصلح 100% === */
.qibla-wrap{display:flex;flex-direction:column;align-items:center;gap:16px;width:100%}
.compass-box{position:relative;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle at 35% 35%, #2e2e2e, #121212);border:2px solid rgba(214,199,161,0.35);box-shadow:0 0 40px rgba(0,0,0,0.7), inset 0 0 30px rgba(214,199,161,0.08);margin:0 auto;overflow:hidden;display:flex;align-items:center;justify-content:center}
.compass-rose{position:absolute;inset:0;border-radius:50%;transition:transform 0.15s linear;will-change:transform}
.compass-rose::before{content:'N';position:absolute;top:14px;left:50%;transform:translateX(-50%);color:#ff6b6b;font-weight:800;font-size:16px;z-index:3;text-shadow:0 0 6px #ff6b6b}
.compass-marks{position:absolute;inset:0;border-radius:50%}
.compass-marks span{position:absolute;left:50%;top:8px;width:2px;height:12px;background:rgba(255,255,255,0.18);border-radius:2px;transform-origin:50% 122px;transform:translateX(-50%) rotate(var(--r))}
.compass-marks span:nth-child(9n+1){height:18px;background:rgba(255,255,255,0.35);width:2.5px}
.qibla-arrow{position:absolute;left:50%;top:50%;width:0;height:0;transform-origin:50% 100%;transition:transform 0.15s linear;will-change:transform;z-index:5}
.qibla-arrow::before{content:'';position:absolute;left:-12px;top:-115px;width:24px;height:115px;background:linear-gradient(180deg,var(--primary),#b89b5e);clip-path:polygon(50% 0, 0 100%, 100% 100%)}
.qibla-arrow::after{content:'🕋';position:absolute;left:-14px;top:-138px;font-size:22px}
.compass-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:14px;height:14px;border-radius:50%;background:var(--primary);z-index:10;border:2px solid #000}
.qibla-info{width:100%;display:flex;flex-direction:column;gap:8px}.qibla-stat{display:flex;justify-content:space-between;background:rgba(255,255,255,0.05);padding:12px 14px;border-radius:12px;font-size:13px;border:1px solid var(--border)}
.qibla-stat b{color:var(--primary)}.qibla-btn{background:var(--primary);color:#000;border:none;padding:12px 18px;border-radius:12px;font-weight:800;width:100%;cursor:pointer}
.qibla-hint{font-size:12px;color:var(--primary);text-align:center;font-weight:700}.qibla-sub-hint{font-size:11px;color:var(--muted);text-align:center}